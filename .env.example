# Copia a ".env" en la raíz del proyecto (junto a app.py) o define las mismas
# claves en el panel de variables de Railway / tu hosting.
# Nunca subas .env con secretos al repositorio.

# --- CheckID (obligatorio para usar la API) ---
# Clave de la cuenta CheckID. Sin esto: error "Defina la variable de entorno CHECKID_API_KEY."
CHECKID_API_KEY=

# URL base de la API (opcional; por defecto el cliente usa https://www.checkid.mx/api/)
# CHECKID_BASE_URL=https://www.checkid.mx/api

# Timeouts HTTP en segundos (opcionales)
# CHECKID_CONNECT_TIMEOUT=10
# CHECKID_REQUEST_TIMEOUT=45

# Caché en memoria de búsquedas repetidas (segundos; mínimo efectivo 5)
# CHECKID_CACHE_TTL_SECONDS=60

# Límite Flask-Limiter para POST /api/checkid/buscar (sintaxis de limits)
# CHECKID_BUSCAR_RATE_LIMIT=20 per minute

# Almacenamiento del rate limit: memory:// en un solo proceso; en Railway con varias
# réplicas usa Redis u otro backend compartido.
# RATELIMIT_STORAGE_URI=memory://

# --- Finiquitos: Excel headcount en OneDrive (fecha de ingreso, sin Graph) ---
# Enlace compartido 1drv.ms / live.com; si se omite, la app usa el enlace por defecto del proyecto.
# HEADCOUNT_ONEDRIVE_URL=https://1drv.ms/x/...
# Hoja (opcional): índice 0-based o nombre exacto de pestaña.
# HEADCOUNT_EXCEL_SHEET_NAME=0
# Patrones Headcount para auditoría SUA (misma URL que comparativo/nómina arriba).
# HEADCOUNT_PATRON_ALIASES=RAFAEL,RAFAEL ALEJANDRO
# O archivo JSON en DATA_DIR: headcount_patron_aliases.json → {"aliases": ["RAFAEL", "RAFAEL ALEJANDRO"]}

# --- Headcount snapshot (copia local SQLite; GET no descarga OneDrive) ---
# HEADCOUNT_SNAPSHOT_TTL_SECONDS=3600
# Minutos hasta considerar snapshot vencido (prioridad sobre TTL si está definido)
# HEADCOUNT_STALE_AFTER_MINUTES=120
# Indica que existe job/cron externo; NO refresca en GET
# HEADCOUNT_AUTO_REFRESH_ENABLED=0
# HEADCOUNT_AUTO_REFRESH_CRON_HINT=0 */2 * * *
# Token para POST /internal/headcount/refresh y /internal/nomina/headcount/refresh
# INTERNAL_REFRESH_TOKEN=
